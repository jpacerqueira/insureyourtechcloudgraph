#!/bin/bash
# 
# BUILD_METHOD = 
# BUILD_METHOD = 1  - docker compose up
# BUILD_METHOD = 2  - docker compose up --build
# BUILD_METHOD = 3  - docker compose up --build --force-recreate
# BUILD_METHOD = 4  - docker compose up -d --build --force-recreate
# BUILD_METHOD =    - docker compose ps

BUILD_METHOD="${1:-0}" # 1 or 0

if [[ "$BUILD_METHOD" == "1" ]]; then
   docker compose down
   docker compose up
elif [[ "$BUILD_METHOD" == "2" ]]; then
   docker compose down
   docker system prune -f
   docker volume prune -f
   docker compose up --build
elif [[ "$BUILD_METHOD" == "3" ]]; then
   docker compose down
   docker compose rm -sfv # just remove containers and volumes of the compose project
   #docker system prune -f
   #docker volume prune -f
   docker volume ls
   docker volume rm -f cloud-services-risk-ratings-api_postgres_data
   echo "populate database"
   head -n 2000000 ../information/datamodel/cloud-risk-datamodel-services-above-sla-outage.csv > data/cloud_service_risk_ratings.csv
   head -n 2000000 ../cloud-information-genai-workbench/pdf_bot_usebatch/outage_report_summary_20241130025047.csv > data/outage_report_summaries.csv
   docker compose up --build --force-recreate
elif [[ "$BUILD_METHOD" == "4" ]]; then
   docker compose down
   docker compose rm -sfv # just remove containers and volumes of the compose project
   #docker system prune -f
   #docker volume prune -f
   docker volume ls
   docker volume rm -f cloud-services-risk-ratings-api_postgres_data
   echo "populate database"
   head -n 2000000 ../information/datamodel/cloud-risk-datamodel-services-above-sla-outage.csv > data/cloud_service_risk_ratings.csv
   head -n 2000000 ../cloud-information-genai-workbench/pdf_bot_usebatch/outage_report_summary_20241130025047.csv > data/outage_report_summaries.csv
   docker compose up -d --build --force-recreate > /dev/null 2>&1
   echo "Customer Backend API , built! Now, wait 10 seconds for the database to be ready."
else
   docker compose ps
fi
