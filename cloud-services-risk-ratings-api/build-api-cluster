#!/bin/bash
# 
# BUILD_METHOD = 
# BUILD_METHOD = 1  - docker compose up
# BUILD_METHOD = 2  - docker compose up --build
# BUILD_METHOD = 3  - docker compose up --build --force-recreate
# BUILD_METHOD = 4  - docker compose up -d --build --force-recreate
# BUILD_METHOD =    - docker compose ps

BUILD_METHOD="${1:-0}" # 1 or 0

DOCKER_PODMAN="${2:-0}" # 1 or 0

if [[ "$DOCKER_PODMAN" == "1" ]]; then
   echo "Using Docker Podman"
   DOCKER_COMPOSE_CMD="docker-compose"
   DOCKER_CMD="podman"
else
   echo "Using Docker"
   DOCKER_COMPOSE_CMD="docker compose"
   DOCKER_CMD="docker"
fi

if [[ "$BUILD_METHOD" == "1" ]]; then
   $DOCKER_COMPOSE_CMD down
   $DOCKER_COMPOSE_CMD up
elif [[ "$BUILD_METHOD" == "2" ]]; then
   $DOCKER_COMPOSE_CMD down
   $DOCKER_COMPOSE_CMD rm -sfv # just remove containers and volumes of the compose project
   $DOCKER_COMPOSE_CMD up --build
elif [[ "$BUILD_METHOD" == "3" ]]; then
   $DOCKER_COMPOSE_CMD down
   $DOCKER_COMPOSE_CMD rm -sfv # just remove containers and volumes of the compose project
   #$DOCKER_CMD system prune -f
   #$DOCKER_CMD volume prune -f
   $DOCKER_CMD volume ls
   $DOCKER_CMD volume rm -f cloud-services-risk-ratings-api_postgres_data
   echo "populate database"
   head -n 2000000 ../information/datamodel/cloud-risk-datamodel-services-above-sla-outage.csv > data/cloud_service_risk_ratings.csv
   LATEST_REPORT=$(ls -1 ../cloud-information-genai-workbench/pdf_bot_usebatch/outage_report_summary_*.csv | sort -r | head -n1)
   head -n 2000000 "$LATEST_REPORT" > data/outage_report_summaries.csv
   $DOCKER_COMPOSE_CMD up --build --force-recreate
elif [[ "$BUILD_METHOD" == "4" ]]; then
   $DOCKER_COMPOSE_CMD down
   $DOCKER_COMPOSE_CMD rm -sfv # just remove containers and volumes of the compose project
   #$DOCKER_CMD system prune -f
   #$DOCKER_CMD volume prune -f
   $DOCKER_CMD volume ls
   $DOCKER_CMD volume rm -f cloud-services-risk-ratings-api_postgres_data
   echo "populate database"
   head -n 2000000 ../information/datamodel/cloud-risk-datamodel-services-above-sla-outage.csv > data/cloud_service_risk_ratings.csv
   LATEST_REPORT=$(ls -1 ../cloud-information-genai-workbench/pdf_bot_usebatch/outage_report_summary_*.csv | sort -r | head -n1)
   head -n 2000000 "$LATEST_REPORT" > data/outage_report_summaries.csv
   $DOCKER_COMPOSE_CMD up -d --build --force-recreate > /dev/null 2>&1
   echo "Customer Backend API , built! Now, wait 10 seconds for the database to be ready."
else
   $DOCKER_COMPOSE_CMD ps
fi
